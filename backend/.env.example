# Copy to .env and adjust. DEBUG defaults to False in settings if unset.
# Docker: docker compose --env-file backend/.env up --build

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Leave empty to use SQLite at backend/db.sqlite3
# Docker Compose builds DATABASE_URL from POSTGRES_* below.
# DATABASE_URL=postgres://luma:CHANGE_ME@db:5432/luma

# Postgres (docker compose) — REQUIRED when using Compose (no password fallback).
POSTGRES_DB=luma
POSTGRES_USER=luma
POSTGRES_PASSWORD=change-me-strong-password

# Optional overrides (defaults: backend/media, backend/staticfiles)
# MEDIA_ROOT=
# STATIC_ROOT=

# Comma-separated origins for CSRF (Vite + production SPA origin)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Optional: path to built React app for same-origin production serving
# Docker sets this automatically. Leave empty for local Vite-only UI.
# FRONTEND_DIST=

# Django → SPA origin for reader "back to library" (mirror of VITE_DJANGO_ORIGIN).
# Local dual-stack default when FRONTEND_DIST is unset: http://127.0.0.1:5173
# Empty or "same" = relative /library/ (Docker / same-origin).
# SPA_ORIGIN=http://127.0.0.1:5173

# Email (password reset)
# Local: console backend prints the reset link in the Django/worker terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@libro.uz
RIGHTS_CONTACT_EMAIL=rights@libro.uz
# Production (DEBUG=False) REQUIRES SMTP unless ALLOW_CONSOLE_EMAIL=1 (staging only):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# ALLOW_CONSOLE_EMAIL=0

# Production TLS (behind nginx/Caddy). For local Docker without HTTPS keep USE_TLS=0.
# USE_TLS=1
# SECURE_HSTS_SECONDS=31536000

# TTS provider abstraction (only "edge" implemented today).
# TTS_PROVIDER=edge
# TTS_VOICE=uz-UZ-MadinaNeural
# Continuity risk: edge-tts is unofficial; plan Azure Speech / Google TTS before marketing.

# Generation abuse controls
# GENERATION_MAX_RUNNING=2
# GENERATION_REGENERATE_DAILY_LIMIT=10
# GENERATION_STALE_QUEUED_SECONDS=300

# Shared cache (required for multi-worker Gunicorn throttles / regenerate quotas).
# Docker Compose sets REDIS_URL=redis://redis:6379/1 automatically.
# Leave unset for local SQLite + single-process runserver (LocMemCache).
# REDIS_URL=redis://127.0.0.1:6379/1
